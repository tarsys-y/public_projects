rules_version = '2';
// Regras do M7 "lite" (sem Cloud Functions): amigos confiáveis + validações
// básicas. A versão anti-fraude completa migra as escritas sensíveis para
// as functions em functions/ (exige plano Blaze).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Perfil e estado sincronizado: só o dono escreve.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
      match /state/{docId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Ligas de amigos: membros leem/escrevem; entrar = adicionar o próprio uid.
    match /leagues/{leagueId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberUids ||
        // entrada na liga: o usuário só pode adicionar a si mesmo
        request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
        request.auth.uid in request.resource.data.memberUids
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /results/{resultId} {
        allow read: if signedIn();
        // resultado imutável: só criação, por membro da liga
        allow create: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberUids &&
          request.resource.data.reportedBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Mercado: anúncio só pelo vendedor; updates permitidos a usuários logados
    // (lances/liquidação client-side — modelo de confiança entre amigos).
    match /marketListings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.sellerUid == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.sellerUid == request.auth.uid;
    }
  }
}
