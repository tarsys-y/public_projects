{
  "name": "squad-dynasty",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test -w @squad-dynasty/engine && npm run test -w mobile",
    "test:coverage": "npm run test:coverage -w @squad-dynasty/engine",
    "sim": "npm run sim -w @squad-dynasty/engine --",
    "data:validate": "npm run validate -w @squad-dynasty/data",
    "data:generate": "npm run generate -w @squad-dynasty/data",
    "data:crests": "npm run crests -w @squad-dynasty/data",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run start -w mobile"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
