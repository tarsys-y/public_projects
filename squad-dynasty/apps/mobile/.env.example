# Modo online (M7) — copie para .env e cole a web config do seu projeto
# Firebase (console.firebase.google.com → Configurações do projeto → Seus apps
# → App da Web). Sem estas variáveis o jogo roda 100% offline.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Sorteios via Cloud Functions (exige plano Blaze + deploy de functions/).
# Deixe vazio/0 para o modo "lite" (sorteios no cliente).
EXPO_PUBLIC_USE_FUNCTIONS=
