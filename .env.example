# B3 / Market Data
BRAPI_TOKEN=your_brapi_token_here

# Database (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Redis (caching)
REDIS_URL=redis://localhost:6379

# Python Quant Service
QUANT_SERVICE_URL=http://localhost:8000

# BCB (Brazilian Central Bank) - no key needed, public API
BCB_API_BASE=https://api.bcb.gov.br/dados/serie/bcdata.sgs

# Alpha Vantage (optional fallback)
ALPHA_VANTAGE_KEY=

# CVM (Brazilian SEC) - no key needed
CVM_API_BASE=https://dados.cvm.gov.br/api

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
